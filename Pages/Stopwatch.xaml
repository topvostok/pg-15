<Page x:Class="Time_Lord_Peshin.Pages.Stopwatch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="782"
      Title="Stopwatch">

    <Grid Background="#FFE8E100">
        <Label x:Name="time" Content="00:00:00" 
               HorizontalAlignment="Center" VerticalAlignment="Top" 
               Margin="0,95,0,0" 
               Foreground="White" FontSize="48" FontWeight="Bold"/>

        <Button x:Name="start" Click="StartStopwatch" 
                Content="Начать" 
                HorizontalAlignment="Left" VerticalAlignment="Center" 
                Width="100" Height="34" 
                Background="White" Foreground="#FFE8E100"
                FontWeight="Bold" FontSize="14"
                BorderThickness="0" Cursor="Hand" Margin="278,0,0,0"/>
        <Button x:Name="reset" Click="ResetStopwatch" 
        Content="Сброс" 
        HorizontalAlignment="Center" VerticalAlignment="Center" 
        Margin="150,0,0,0"
        Width="100" Height="35" 
        Background="White" Foreground="#FFE8E100"
        FontWeight="Bold" FontSize="14"
        BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>